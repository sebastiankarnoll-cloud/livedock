{
  "name": "livedock-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "bash scripts/dev-db.sh",
    "migrate": "node scripts/migrate.ts",
    "purge": "node scripts/purge.ts",
    "worker": "node scripts/worker.ts",
    "test:e2e": "node test/e2e/login.e2e.cjs && node --env-file=.env test/e2e/staff.e2e.cjs",
