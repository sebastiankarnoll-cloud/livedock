    "worker:dev": "node --env-file=.env scripts/worker.ts"
  },
  "dependencies": {
    "next": "^16.4.5",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "^3.4.0",
    "smtp-server": "^3.21.3",
    "typescript": "^5.6.0"
  }
