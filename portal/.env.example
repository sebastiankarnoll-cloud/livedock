# App role: no superuser, no BYPASSRLS. Row level security applies.
DATABASE_URL=postgres://livedock_app:app@localhost:5432/livedock_dev
# Owner role: only for migrations.
DATABASE_ADMIN_URL=postgres://livedock_owner:owner@localhost:5432/livedock_dev
# dev = mails are stored in the outbox table (shown at /dev/postfach). Real mail service (EU) comes later.
MAILER=dev
PUBLIC_URL=http://localhost:3000
# Development only: page /dev/postfach shows stored mails. Never set in production.
DEV_OUTBOX=1
