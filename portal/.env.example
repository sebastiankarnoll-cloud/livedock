# Copy to .env or let `npm run db:setup` write it (with generated passwords).
# App role: no superuser, no BYPASSRLS. Row level security applies.
DATABASE_URL=postgres://livedock_app:<password>@localhost:5432/livedock_dev
# Owner role: only for migrations.
DATABASE_ADMIN_URL=postgres://livedock_owner:<password>@localhost:5432/livedock_dev
# Background worker (checks, 30-day deletion): the only role that bypasses row level security.
DATABASE_WORKER_URL=postgres://livedock_worker:<password>@localhost:5432/livedock_dev
# Same roles on the test database (used by npm test).
TEST_DATABASE_URL=postgres://livedock_app:<password>@localhost:5432/livedock_test
TEST_DATABASE_ADMIN_URL=postgres://livedock_owner:<password>@localhost:5432/livedock_test
TEST_DATABASE_WORKER_URL=postgres://livedock_worker:<password>@localhost:5432/livedock_test
# dev = mails are stored in the outbox table (shown at /dev/postfach). Real mail: MAILER=smtp plus the values below.
MAILER=dev
# SMTP_HOST=<host of the mail account, see All-inkl KAS>
# SMTP_PORT=587
# SMTP_USER=info@livedock.de
# SMTP_PASS=<set only in the server settings, never in git or chat>
# MAIL_FROM="livedock. <info@livedock.de>"
# Development only: page /dev/postfach shows stored mails. Never set in production.
DEV_OUTBOX=1
PUBLIC_URL=http://localhost:3000
STORAGE_DIR=./storage
